---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { SITE } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  jsonLd?: object;
}

const {
  title,
  description = SITE.description,
  ogImage = '/og/home.jpg',
  ogType = 'website',
  jsonLd,
} = Astro.props;

const pageTitle = title ? `${title} – Arbaz Siddiqui` : `Arbaz Siddiqui – Software Engineer`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const path = Astro.url.pathname;
const active = (p: string) => (path.startsWith(p) ? 'active' : '');
const ogImageAbs = new URL(ogImage, SITE.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href="/fonts/hanken.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Arbaz Siddiqui" href="/rss.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:site_name" content="Arbaz Siddiqui" />
    {ogImage.startsWith('/og/') && <meta property="og:image:width" content="1200" />}
    {ogImage.startsWith('/og/') && <meta property="og:image:height" content="630" />}
    <script is:inline>
      const t = localStorage.getItem('theme') ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.dataset.theme = t;
    </script>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <ClientRouter />
  </head>
  <body>
    <header class="site-header" transition:persist>
      <nav class="hall nav">
        <a href="/" class="brand">Arbaz Siddiqui</a>
        <div class="links">
          <a href="/projects" class={active('/projects')}>Projects</a>
          <a href="/blog" class={active('/blog')}>Writing</a>
          <a href="/about" class={active('/about')}>About</a>
          <button id="theme-toggle" aria-label="Toggle color theme">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="5"></circle>
              <path d="M12 1v3M12 20v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M1 12h3M20 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"></path>
            </svg>
          </button>
        </div>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="hall close">
        <p class="close-line">Building something serious with AI? <a href={`mailto:${SITE.email}`}>Write to me.</a></p>
      </div>
      <div class="hall foot">
        <div class="foot-left">
          <p>Arbaz Siddiqui</p>
        </div>
        <div class="foot-right">
          <a href={SITE.github}>GitHub</a>
          <a href={SITE.huggingface}>Hugging&nbsp;Face</a>
          <a href={SITE.linkedin}>LinkedIn</a>
          <a href={SITE.substack}>Newsletter</a>
          <a href="/rss.xml">RSS</a>
        </div>
      </div>
    </footer>

    <script>
      function bindToggle() {
        document.getElementById('theme-toggle')?.addEventListener('click', () => {
          const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          localStorage.setItem('theme', next);
        });
      }
      bindToggle();
      document.addEventListener('astro:after-swap', () => {
        const t = localStorage.getItem('theme');
        if (t) document.documentElement.dataset.theme = t;
      });
    </script>

    <style>
      .site-header { background: var(--ink); padding-block: 1rem; }
      .nav { display: flex; justify-content: space-between; align-items: center; }
      .brand { font-weight: 700; font-size: 1.05rem; color: #ffffff; letter-spacing: -0.01em; }
      .brand:hover { text-decoration: none; color: #ffffff; }
      .links { display: flex; gap: 1.5rem; align-items: center; font-size: 0.98rem; }
      .links a { color: #d6d2c8; padding: 0.35rem 0.15rem; transition: color 160ms var(--ease); }
      .links a.active { color: var(--accent-on-ink); }
      .links a:hover { color: var(--ink-fg); text-decoration: none; }
      #theme-toggle { display: grid; place-items: center; color: var(--ink-soft); padding: 0.5rem; margin-block: -0.5rem; border-radius: 8px; transition: color 160ms var(--ease), background 160ms var(--ease); }
      #theme-toggle:hover { background: oklch(1 0 0 / 0.08); }
      #theme-toggle svg { width: 15px; height: 15px; }
      #theme-toggle:hover { color: var(--ink-fg); }
      main { flex: 1; }
      .site-footer { margin-top: 3.5rem; background: var(--ink); color: var(--ink-fg); }
      .close-line { padding-block: 2.2rem 0.5rem; font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 700; letter-spacing: -0.02em; color: var(--ink-fg); }
      .close-line a { color: var(--accent-on-ink); text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--accent-on-ink) 45%, transparent); text-underline-offset: 5px; }
      .close-line a:hover { text-decoration-color: currentColor; }
      .foot { display: flex; justify-content: space-between; gap: 1.5rem; padding-block: 1.8rem 2.6rem; flex-wrap: wrap; }
      .foot-right { display: flex; gap: 1.6rem; flex-wrap: wrap; align-items: baseline; }
      .foot-left p + p { margin-top: 0.2rem; }
      .foot a, .foot p { color: var(--ink-soft); font-family: var(--sans); font-size: 0.95rem; transition: color 160ms var(--ease); }
      .foot a:hover { color: var(--ink-fg); text-decoration: none; }
    </style>
  </body>
</html>
