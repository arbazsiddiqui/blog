---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import hero from '../assets/mercuro/01_hero_clean.png';
import daily from '../assets/mercuro/02_daily_clean.png';
import themes from '../assets/mercuro/04_themes_clean.png';

const shots = [
  { img: hero, alt: 'Mercuro gameplay, filling mercury tubes against row and column clues' },
  { img: daily, alt: 'Mercuro daily puzzles: Warm-Up, Daily, and Challenge' },
  { img: themes, alt: 'Mercuro themes, nine visual styles' },
];

const jsonLdApp = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Mercuro: Thermometers Puzzle',
  operatingSystem: 'iOS',
  applicationCategory: 'GameApplication',
  author: { '@type': 'Person', name: 'Arbaz Siddiqui' },
  url: 'https://www.arbazsiddiqui.me/mercuro',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
const jsonLd = [jsonLdApp, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.arbazsiddiqui.me/"}, {"@type": "ListItem", "position": 2, "name": "Projects", "item": "https://www.arbazsiddiqui.me/projects/"}, {"@type": "ListItem", "position": 3, "name": "Mercuro", "item": "https://www.arbazsiddiqui.me/mercuro/"}]}];
---

<Base
  title="Mercuro: Thermometer Logic Puzzle"
  description="A grid-deduction puzzle game with its own solver and generator, 660 curated puzzles, seeded daily challenges, and native apps for iOS and Android."
  ogImage="/og/mercuro.jpg"
  ogImageAlt="Mercuro, a thermometer logic puzzle game for iOS and Android."
  jsonLd={jsonLd}
>
  <article class="narrow section">
    <p class="kicker">Featured in gaming newsletters</p>
    <h1 class="page-title">Mercuro</h1>
    <p class="lede">
      Fill the thermometers to match the clues. A quiet, sudoku-adjacent
      logic game. No timers, no lives to wait for, and nothing behind a
      paywall.
    </p>

    <dl class="facts">
      <dt>Platform</dt><dd>iPhone, iPad, Mac, Vision · <a href="https://apps.apple.com/app/id6762402072" target="_blank" rel="noopener">App Store</a> · Android in closed testing</dd>
      <dt>Content</dt><dd>660 curated puzzles across 8 board sizes · 3 daily games · 40 achievements · 9 themes</dd>
      <dt>Model</dt><dd>Free game, complete · $4.99 one-time Pro, $2.99 remove ads · no subscription</dd>
      <dt>iOS stack</dt><dd>Pure SwiftUI (no game engine), Swift 6 strict concurrency, GameKit, StoreKit 2</dd>
      <dt>Android stack</dt><dd>Native Kotlin + Jetpack Compose, pixel-parity port</dd>
    </dl>

    <div class="shots">
      {shots.map((s) => (
        <Image src={s.img} alt={s.alt} width={420} widths={[280, 420, 640]} sizes="(max-width: 640px) 90vw, 280px" loading="lazy" />
      ))}
    </div>

    <div class="prose">
      <h2>Gameplay and UX</h2>
      <p>
        <strong>The game engine.</strong> Its own puzzle mathematics. A
        constraint solver that proves every board has exactly one solution,
        a generator that searches for boards with clean deduction chains,
        and a seeded random core so the whole world gets the same three
        daily games without a server round-trip.
      </p>
      <p>
        <strong>The hint system.</strong> It does not fill a cell for you. It
        finds the next move that is provable from what is already on the board,
        so a stuck player keeps going instead of losing the puzzle.
      </p>
      <p>
        <strong>The polish.</strong> Nine themes, custom sound design,
        haptics on every commit, 40 achievements and a rank ladder, Game
        Center leaderboards, and offline play with iCloud sync. Built
        natively twice, SwiftUI on iOS and Kotlin with Compose on Android,
        against one shared puzzle core down to pixel-parity screenshot
        tests.
      </p>
      <h2>Links</h2>
      <p>
        <a href="https://apps.apple.com/app/id6762402072" target="_blank" rel="noopener">App Store</a>
      </p>
    </div>
  </article>
</Base>

<style>
  .page-title { margin-block: 0.35rem 0.8rem; }
  .lede { margin-bottom: 1.6rem; }
  /* three across, tracks that cannot exceed the rail */
  .shots {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-bottom: 2.4rem;
  }
  .shots img { width: 100%; height: auto; border-radius: 14px; }
  @media (max-width: 640px) {
    /* swipe instead of a tall vertical stack */
    .shots {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      margin-inline: calc(-1 * clamp(1.2rem, 3.5vw, 2.5rem));
      padding-inline: clamp(1.2rem, 3.5vw, 2.5rem);
    }
    .shots::-webkit-scrollbar { display: none; }
    .shots img { flex: 0 0 78%; scroll-snap-align: center; }
  }
</style>
