---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { SITE } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: string;
  jsonLd?: object;
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  ogImage = '/og/arbaz-siddiqui.jpg',
  ogImageAlt,
  ogType = 'website',
  jsonLd,
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} | Arbaz Siddiqui` : 'Arbaz Siddiqui | AI Infrastructure & Distributed Systems';
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const path = Astro.url.pathname;
const active = (p: string) => (path.startsWith(p) ? 'active' : '');
const socialImageAbs = new URL(ogImage, SITE.url).href;
const socialImageAlt =
  ogImageAlt ??
  'Illustrated portrait of Arbaz Siddiqui with abstract signal lines resolving into engineered systems.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Arbaz Siddiqui" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1011" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href="/fonts/hanken.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="Arbaz Siddiqui" href="/rss.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImageAbs} />
    <meta property="og:image:secure_url" content={socialImageAbs} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="og:site_name" content="Arbaz Siddiqui" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@arbazsiddiqui_" />
    <meta name="twitter:creator" content="@arbazsiddiqui_" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageAbs} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <script is:inline>
      const t = localStorage.getItem('theme') ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.dataset.theme = t;
    </script>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <ClientRouter />
  </head>
  <body>
    <header class="site-header" transition:persist>
      <nav class="hall nav">
        <a href="/" class="brand">Arbaz Siddiqui</a>
        <div class="links">
          <a href="/projects" class={active('/projects')}>Projects</a>
          <a href="/blog" class={active('/blog')}>Writing</a>
          <a href="/about" class={active('/about')}>About</a>
          <button id="theme-toggle" aria-label="Toggle color theme">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="5"></circle>
              <path d="M12 1v3M12 20v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M1 12h3M20 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"></path>
            </svg>
          </button>
        </div>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="hall close">
        <p class="close-line">Building something serious with AI? <a href={`mailto:${SITE.email}`}>Write to me.</a></p>
      </div>
      <div class="hall foot">
        <p class="foot-brand">Arbaz Siddiqui</p>
        <div class="foot-right">
          <a href={SITE.github} target="_blank" rel="noopener">GitHub</a>
          <a href={SITE.huggingface} target="_blank" rel="noopener">Hugging&nbsp;Face</a>
          <a href={SITE.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          <a href={SITE.substack} target="_blank" rel="noopener">Newsletter</a>
          <a href="/rss.xml">RSS</a>
        </div>
      </div>
    </footer>

    <script>
      function bindToggle() {
        document.getElementById('theme-toggle')?.addEventListener('click', () => {
          const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          localStorage.setItem('theme', next);
        });
      }
      bindToggle();
      document.addEventListener('astro:after-swap', () => {
        const t = localStorage.getItem('theme');
        if (t) document.documentElement.dataset.theme = t;
      });
    </script>

    <style>
      .site-header { border-bottom: 1px solid var(--line); padding-block: 0.95rem; }
      .nav { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
      .brand { font-weight: 700; font-size: 1.05rem; color: var(--fg); letter-spacing: -0.01em; white-space: nowrap; }
      .brand:hover { text-decoration: none; color: var(--soft); }
      .links { display: flex; gap: 1.35rem; align-items: center; font-size: 0.98rem; flex-shrink: 0; }
      .links a { color: var(--soft); padding: 0.35rem 0.1rem; transition: color 160ms var(--ease); }
      .links a.active { color: var(--accent); }
      .links a:hover { color: var(--fg); text-decoration: none; }
      #theme-toggle { display: grid; place-items: center; color: var(--faint); padding: 0.5rem; margin-block: -0.5rem; margin-right: -0.5rem; border-radius: 8px; transition: color 160ms var(--ease), background 160ms var(--ease); }
      #theme-toggle:hover { background: color-mix(in srgb, var(--fg) 8%, transparent); }
      #theme-toggle svg { width: 15px; height: 15px; }
      #theme-toggle:hover { color: var(--fg); }
      main { flex: 1; }
      .site-footer { margin-top: 3.5rem; border-top: 1px solid var(--line); }
      .close-line { padding-block: 2.2rem 0.5rem; font-size: clamp(1.4rem, 3vw, 1.9rem); font-weight: 700; letter-spacing: -0.02em; color: var(--fg); }
      .close-line a { color: var(--accent); text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--accent) 45%, transparent); text-underline-offset: 5px; }
      .close-line a:hover { text-decoration-color: currentColor; }
      .foot { display: flex; justify-content: space-between; align-items: baseline; gap: 0.9rem 1.5rem; padding-block: 1.4rem 2.6rem; flex-wrap: wrap; }
      .foot-right { display: flex; gap: 0.85rem 1.35rem; flex-wrap: wrap; align-items: baseline; }
      .foot-left p + p { margin-top: 0.2rem; }
      .foot a, .foot p { color: var(--soft); font-family: var(--sans); font-size: 0.95rem; transition: color 160ms var(--ease); }
      .foot a:hover { color: var(--fg); text-decoration: none; }
      .foot .foot-brand { color: var(--fg); font-weight: 640; letter-spacing: -0.01em; font-size: 0.98rem; }
      @media (max-width: 560px) {
        .site-footer { margin-top: 2.4rem; }
        .close-line { padding-block: 1.7rem 0.3rem; font-size: 1.3rem; line-height: 1.3; }
        .foot { flex-direction: column; align-items: flex-start; gap: 0.6rem; padding-block: 1.1rem 1.7rem; }
        .foot a { font-size: 0.9rem; }
        .foot .foot-brand { font-size: 0.95rem; }
        .foot a, .foot p { line-height: 1.3; }
        .foot-right { gap: 0.4rem 1.05rem; }
      }
      @media (max-width: 460px) {
        .nav { gap: 0.75rem; }
        .brand { font-size: 0.92rem; }
        .links { gap: 0.85rem; font-size: 0.86rem; }
        #theme-toggle { padding: 0.35rem; margin-right: -0.35rem; }
        #theme-toggle svg { width: 14px; height: 14px; }
      }
    </style>
  </body>
</html>
