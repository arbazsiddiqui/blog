/
  Link: </.well-known/api-catalog>; rel="api-catalog"
  Link: </llms.txt>; rel="describedby"; type="text/plain"

/.well-known/api-catalog
  Content-Type: application/linkset+json

/slop-corner/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Hashed build output never changes under the same name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Media and images keep their names across deploys: a week, refreshed in the background.
/video/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/og/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/thumbnails/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/fonts/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/favicon.ico
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Demos change with their posts: a day.
/kev-browser-use-demo/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/sqlite-sparse-demo/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Files agents read: an hour.
/llms.txt
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Demo data and library files are fetched by the demo pages, not meant as search results.
/sqlite-sparse-demo/*.gz
  X-Robots-Tag: noindex
/sqlite-sparse-demo/*.mjs
  X-Robots-Tag: noindex
/sqlite-sparse-demo/*.wasm
  X-Robots-Tag: noindex
