---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const jsonLd = {"@context": "https://schema.org", "@type": "Blog", "name": "Writing by Arbaz Siddiqui", "url": "https://www.arbazsiddiqui.me/blog/", "author": {"@type": "Person", "name": "Arbaz Siddiqui", "url": "https://www.arbazsiddiqui.me"}};
---

<Base
  title="Writing"
  description="Technical writing by Arbaz Siddiqui on Node.js, networking, and web internals, including articles featured in JavaScript newsletters."
  jsonLd={jsonLd}
>
  <section class="narrow section">
    <h1 class="page-title">Writing</h1>
    <p class="soft intro">
      Deep dives from my Node.js years: memory leaks, proxies, CORS, DNS.
      Several were picked up by JavaScript newsletters and are still doing the
      rounds. New writing about the AI-era projects is on the way; the
      <a href="https://arbazsiddiqui.substack.com" target="_blank" rel="noopener">newsletter</a> will carry it first.
    </p>
    <ul class="rows">
      {posts.map((post) => (
        <li class="post-row">
          <a class="row-link" href={`/${post.data.slug}/`}>{post.data.title}</a>
          <span class="row-meta">{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}</span>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .page-title { margin-bottom: 0.8rem; }
  .intro { margin-bottom: 2.4rem; }
  .rows > li { padding-block: 0.8rem; }
  .row-link { font-size: 1.1rem; }
</style>
