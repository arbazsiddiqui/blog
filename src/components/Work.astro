---
import { Image } from 'astro:assets';

interface Props {
  href: string;
  title: string;
  medium: string;
  sentence: string;
  stat?: string;
  img: ImageMetadata;
  alt: string;
  hero?: boolean;
  eager?: boolean;
  links?: { label: string; url: string }[];
}

const { href, title, medium, sentence, stat, img, alt, hero = false, eager = false, links = [] } = Astro.props;
const aboveFold = hero || eager;
---

<article class:list={['work', { 'work-hero': hero }]}>
  <a class="frame" href={href} aria-label={title}>
    <Image
      src={img}
      alt={alt}
      widths={[520, 820, 1280, 1700]}
      sizes={hero ? '(max-width: 720px) 100vw, 62rem' : '(max-width: 720px) 100vw, 30rem'}
      loading={aboveFold ? 'eager' : 'lazy'}
      fetchpriority={aboveFold ? 'high' : undefined}
    />
  </a>
  <div class="placard">
    <h2 class="w-title"><a href={href}>{title}</a></h2>
    <p class="medium">{medium}</p>
    <p class="sentence">{sentence}</p>
    {stat && <p class="stat">{stat}</p>}
    {links.length > 0 && (
      <p class="onview">
        {links.map((l) => (
          l.url.startsWith('/')
            ? <a href={l.url}>{l.label}</a>
            : <a href={l.url} target="_blank" rel="noopener">{l.label}</a>
        ))}
      </p>
    )}
  </div>
</article>
