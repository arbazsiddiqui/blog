---
import Base from '../layouts/Base.astro';
import { PERSON_REF } from '../data/person';
import { getCollection, render } from 'astro:content';
import { SITE } from '../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const dateStr = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// First paragraph of the post as its description: answer engines quote the meta
// description, and a generic byline gives them nothing to quote.
function summarize(md: string, max = 158): string {
  const kept: string[] = [];
  let fence = false, html = false;
  for (const raw of md.split('\n')) {
    const l = raw.trim();
    if (l.startsWith('```')) { fence = !fence; continue; }
    if (fence) continue;
    if (/^<(div|script|style|details|pre|form|ol|ul|table|p)\b/i.test(l)) html = true;
    if (html) { if (/^<\/(div|script|style|details|pre|form|ol|ul|table|p)>/i.test(l)) html = false; continue; }
    if (!l || /^[#|!<]/.test(l)) { if (kept.length) break; continue; }
    kept.push(l);
  }
  const text = kept.join(' ')
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
    .replace(/[`*_]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
  if (text.length <= max) return text;
  let out = '';
  for (const sentence of text.split(/(?<=\.)\s+/)) {
    if ((out + ' ' + sentence).trim().length > max) break;
    out = (out + ' ' + sentence).trim();
  }
  return out || text.slice(0, max).replace(/\s+\S*$/, '');
}

const url = `https://www.arbazsiddiqui.me/${post.data.slug}/`;
const description = post.data.description ?? (summarize(post.body ?? '') || `${post.data.title}, an article by Arbaz Siddiqui.`);
const socialImage = post.data.ogImage ?? post.data.thumbnail;
const image = socialImage ? new URL(socialImage, SITE.url).href : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description,
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  author: PERSON_REF,
  publisher: PERSON_REF,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  url,
  inLanguage: 'en',
  keywords: post.data.tags.join(', '),
  ...(image ? { image } : {}),
};
---

<Base
  title={post.data.title}
  description={description}
  ogImage={post.data.ogImage}
  ogImageAlt={post.data.ogImageAlt}
  ogType="article"
  jsonLd={jsonLd}
>
  <article class="narrow section">
    <p class="kicker">{dateStr} · {post.data.tags.join(' · ')}</p>
    <h1 class="page-title title">{post.data.title}</h1>
    <div class="prose">
      <Content />
    </div>
    <nav class="fn">
      <a class="fn-back" href="/blog">All writing</a>
      <span class="fn-sep" aria-hidden="true">·</span>
      <a class="fn-sub" href={SITE.substack} target="_blank" rel="noopener">Get new posts by email</a>
    </nav>
  </article>
</Base>

<style>
  .title { margin-block: 0.5rem 2rem; }
  .fn {
    display: flex; align-items: baseline; gap: 0.7rem; flex-wrap: wrap;
    margin-top: 3.4rem; padding-top: 1.4rem; border-top: 1px solid var(--line);
    font-size: 1.05rem;
  }
  .fn a { text-decoration: none; }
  .fn a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .fn-back { color: var(--fg); font-weight: 600; }
  .fn-sep { color: var(--faint); }
  .fn-sub { color: var(--soft); }
  .fn-sub:hover { color: var(--fg); }
</style>
